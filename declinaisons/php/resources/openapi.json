{
  "openapi": "3.0.3",
  "info": {
    "title": "MiniShop",
    "description": "Application fil rouge de la formation CI/CD & IA",
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "État de l'application",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/products": {
      "get": {
        "summary": "Products",
        "operationId": "products",
        "responses": {
          "200": {
            "description": "Catalogue",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Product"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/products/{product_id}": {
      "get": {
        "summary": "Product",
        "operationId": "product",
        "parameters": [
          {
            "name": "product_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "mug"
          }
        ],
        "responses": {
          "200": {
            "description": "Produit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Product"
                }
              }
            }
          },
          "404": {
            "description": "Erreur",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/cart/quote": {
      "post": {
        "summary": "Cart Quote",
        "operationId": "cart_quote",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Cart"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Devis",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Quote"
                }
              }
            }
          },
          "404": {
            "description": "Erreur",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Corps invalide ou règle métier refusée (quantité, coupon, panier vide)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/orders": {
      "post": {
        "summary": "Create Order",
        "operationId": "create_order",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Cart"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Commande créée",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Order"
                }
              }
            }
          },
          "404": {
            "description": "Erreur",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Corps invalide ou règle métier refusée (quantité, coupon, panier vide)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/orders/{order_id}": {
      "get": {
        "summary": "Get Order",
        "operationId": "get_order",
        "parameters": [
          {
            "name": "order_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Commande",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Order"
                }
              }
            }
          },
          "404": {
            "description": "Erreur",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Health": {
        "type": "object",
        "required": [
          "status",
          "version"
        ],
        "properties": {
          "status": {
            "type": "string",
            "example": "ok"
          },
          "version": {
            "type": "string",
            "example": "1.0.0"
          }
        }
      },
      "Product": {
        "type": "object",
        "required": [
          "id",
          "name",
          "price",
          "stock"
        ],
        "properties": {
          "id": {
            "type": "string",
            "example": "mug"
          },
          "name": {
            "type": "string"
          },
          "price": {
            "type": "string",
            "pattern": "^-?[0-9]+\\.[0-9]{2}$",
            "example": "27.40"
          },
          "stock": {
            "type": "integer"
          }
        }
      },
      "Item": {
        "type": "object",
        "required": [
          "product_id",
          "qty"
        ],
        "properties": {
          "product_id": {
            "type": "string",
            "example": "mug"
          },
          "qty": {
            "type": "integer",
            "minimum": 1,
            "maximum": 99,
            "example": 2
          }
        }
      },
      "Cart": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Item"
            }
          },
          "coupon": {
            "type": "string",
            "nullable": true,
            "example": "WELCOME10"
          }
        }
      },
      "Line": {
        "type": "object",
        "required": [
          "product_id",
          "qty",
          "unit_price",
          "total"
        ],
        "properties": {
          "product_id": {
            "type": "string"
          },
          "qty": {
            "type": "integer"
          },
          "unit_price": {
            "type": "string",
            "pattern": "^-?[0-9]+\\.[0-9]{2}$",
            "example": "27.40"
          },
          "total": {
            "type": "string",
            "pattern": "^-?[0-9]+\\.[0-9]{2}$",
            "example": "27.40"
          }
        }
      },
      "Quote": {
        "type": "object",
        "required": [
          "lines",
          "subtotal",
          "discount",
          "shipping",
          "total",
          "coupon"
        ],
        "properties": {
          "lines": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Line"
            }
          },
          "subtotal": {
            "type": "string",
            "pattern": "^-?[0-9]+\\.[0-9]{2}$",
            "example": "27.40"
          },
          "discount": {
            "type": "string",
            "pattern": "^-?[0-9]+\\.[0-9]{2}$",
            "example": "27.40"
          },
          "shipping": {
            "type": "string",
            "pattern": "^-?[0-9]+\\.[0-9]{2}$",
            "example": "27.40"
          },
          "total": {
            "type": "string",
            "pattern": "^-?[0-9]+\\.[0-9]{2}$",
            "example": "27.40"
          },
          "coupon": {
            "type": "string",
            "nullable": true,
            "example": "WELCOME10"
          }
        }
      },
      "Order": {
        "type": "object",
        "required": [
          "id",
          "lines",
          "subtotal",
          "discount",
          "shipping",
          "total",
          "coupon"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{12}$"
          },
          "lines": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Line"
            }
          },
          "subtotal": {
            "type": "string",
            "pattern": "^-?[0-9]+\\.[0-9]{2}$",
            "example": "27.40"
          },
          "discount": {
            "type": "string",
            "pattern": "^-?[0-9]+\\.[0-9]{2}$",
            "example": "27.40"
          },
          "shipping": {
            "type": "string",
            "pattern": "^-?[0-9]+\\.[0-9]{2}$",
            "example": "27.40"
          },
          "total": {
            "type": "string",
            "pattern": "^-?[0-9]+\\.[0-9]{2}$",
            "example": "27.40"
          },
          "coupon": {
            "type": "string",
            "nullable": true,
            "example": "WELCOME10"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "detail"
        ],
        "properties": {
          "detail": {
            "type": "string",
            "example": "Produit inconnu : licorne"
          }
        }
      },
      "ValidationError": {
        "type": "object",
        "required": [
          "detail"
        ],
        "properties": {
          "detail": {
            "oneOf": [
              {
                "type": "string",
                "example": "Coupon inconnu : NOEL"
              },
              {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "type",
                    "loc",
                    "msg"
                  ],
                  "properties": {
                    "type": {
                      "type": "string"
                    },
                    "loc": {
                      "type": "array",
                      "items": {
                        "oneOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "integer"
                          }
                        ]
                      }
                    },
                    "msg": {
                      "type": "string"
                    },
                    "input": {},
                    "ctx": {
                      "type": "object"
                    }
                  }
                }
              }
            ]
          }
        }
      }
    }
  }
}
