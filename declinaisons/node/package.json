{
  "name": "minishop-pricing",
  "version": "1.0.0",
  "description": "Règles de prix de MiniShop — déclinaison Node.js de l'atelier CI/CD",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "vitest run tests/unit tests/api tests/generated",
    "test:unit": "vitest run tests/unit",
    "test:api": "vitest run tests/api",
    "test:watch": "vitest tests/unit tests/api",
    "test:http": "vitest run tests/boite-noire",
    "test:e2e": "playwright test --project=chromium",
    "coverage": "vitest run tests/unit tests/api --coverage",
    "lint": "eslint .",
    "lint:security": "eslint -c eslint.security.config.js --max-warnings 0 src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "mutation": "stryker run",
    "mutation:generated": "stryker run stryker.generated.config.json"
  },
  "dependencies": {
    "@fastify/static": "^10.1.11",
    "@fastify/swagger": "^9.9.5",
    "@fastify/swagger-ui": "^6.1.4",
    "decimal.js": "^10.6.0",
    "fastify": "^5.12.8",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@microsoft/eslint-formatter-sarif": "^3.1.0",
    "@playwright/test": "^1.65.1",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@vitest/coverage-v8": "~4.1.12",
    "eslint": "^10.15.0",
    "eslint-plugin-security": "^4.2.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "vitest": "~4.1.12"
  }
}
