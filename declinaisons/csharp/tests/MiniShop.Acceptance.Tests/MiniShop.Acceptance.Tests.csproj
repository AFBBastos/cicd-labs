<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tests « boîte noire » (Ateliers 8 et 9) : ils parlent par HTTP à l'application lancée dans Docker.
       Ce projet est volontairement HORS de MiniShop.slnx : la suite unitaire, son seuil de couverture,
       Stryker et le pipeline de l'Atelier 2 ne le voient pas. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="JunitXml.TestLogger" Version="8.1.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="Microsoft.Playwright.Xunit" Version="1.64.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
